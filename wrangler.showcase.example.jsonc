{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsunagu-gs-showcase",
  "main": "backend/showcase-worker.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "APP_ORIGIN": "https://YOUR_SHOWCASE_ORIGIN.invalid"
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "tsunagu-gs-showcase-platform",
      "database_id": "CREATE_NEW_ISOLATED_PLATFORM_DB"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SHOWCASE_DATABASES",
        "class_name": "ShowcaseDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "showcase-edit-v1",
      "new_sqlite_classes": [
        "ShowcaseDatabase"
      ]
    }
  ]
}
