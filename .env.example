# ローカル開発は外部送信を実行しません。実値をここに書かないでください。
PORT=4180
TSUNAGU_LOCAL_DIR=.local

# Cloudflare本番はwrangler secretで設定（このファイルを読み込みません）。
# AUTH_SECRET: ランダムな32文字以上
# CREDENTIAL_KEY: ランダムな32bytesのBase64
# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_PROVISION_TOKEN / WORKERS_SUBDOMAIN
# MAIL_FROM と BREVO_API_KEY または RESEND_API_KEY（メールログインに必須）
# 未設定時はメール入力を停止しGoogleログイン/管理者確認を案内。OTPのCCやWeb公開はしない。
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET（Googleログインを有効化する場合）
# DRIVE_GOOGLE_CLIENT_ID / DRIVE_GOOGLE_CLIENT_SECRET（Drive連携専用OAuthクライアント）
# Drive OAuth callback: APP_ORIGIN + /api/drive/callback
# OPENAI_API_KEY / AI_MODEL（個別提案の生成を有効化する場合。ローカルでは未接続）
# AI_PRICING_JSON: inputUsdPerMillion, cachedUsdPerMillion, outputUsdPerMillion, version
# 原価の単価が未設定のときは原価未取得。0円とは扱わない。
# APP_ORIGINとPLATFORM_DBは本番環境の作成後にwranglerの設定を更新

# 検証環境だけ: SLACK_WEBHOOK_URL（対象チャンネル専用のIncoming Webhook）
# または SLACK_BOT_TOKEN（chat:write権限。詳細はSLACK-NOTIFICATIONS.md）
# TIMEREX_WEBHOOK_SECRETS_JSON: OA IDをキー、TimeRexのSecurity Tokenを値にしたJSONを暗号化Secretとして設定
# 実値をこのファイルやGitへ保存しない。詳細はTIMEREX-VERIFICATION.md

# 営業担当者LINE（顧客用LINEとは別チャネル。初期値は無効）
# ASSISTANT_LINE_ENABLED=true
# ASSISTANT_LINE_DESTINATION: 担当者チャネルのbot userId
# ASSISTANT_LINE_SECRET / ASSISTANT_LINE_TOKEN: secretで設定しGitへ保存しない
# Webhook: APP_ORIGIN + /webhooks/staff-line
# ASSISTANT_FEEDS_JSON: {"tenantId:oaId":{"url":"https://approved-source.example/feed.json","token":"optional"}}
# フィードはsourceSchemaに一致する配列。未設定なら外部取得しない。
# 全件スナップショット（最大100件）。削除商品は非公開、取得失敗時の在庫は不明にする。
# ASSISTANT_SEARCH_JSON: {"tenantId:oaId":{"url":"https://search-adapter.example/api","token":"optional","allowedHosts":["publisher.example.com"]}}
# search/articleの両操作を受け付けるJSONアダプタ。任意の検索API URLをそのまま設定するものではない。
# 検索・記事本文抽出の契約と商品入力例: reports/ASSISTANT-INTEGRATION-2026-10-02.md
# 定期AI/検索/同期は初期値OFF。管理者設定で上限を確認して有効化する。
# AI上限20回/日/OA（初回+修正）。検索は60〜1440分、フィードは15〜1440分から画面で選択。
# 取得の既定は6時間。日次取得上限は1440/選択した分数（手動取得も含む）。
# 担当者通知は日次上限なし、返信/その他を別々に最大3件/分。受信時間の既定は日本時間8〜21時。
# 商品の認証済み即時取込: /api/tenants/:tenantId/accounts/:oaId/assistant/catalog-events
# 通常のログイン・OA管理権限・Origin検証を使用。外部サービス向け常設トークンは追加していない。
# 詳細: reports/LINE-ASSISTANT-2026-10-02.md

# OpenAI web research + separate Drive archive grant. Disabled by default.
ASSISTANT_RESEARCH_ENABLED=false

# Separate optional consent flow. No authorization or research starts by default.
ASSISTANT_NEWS_AUTHORIZATION_ENABLED=false
# Set an explicitly verified web_search-capable model before enabling research.
ASSISTANT_RESEARCH_MODEL=
